// Prisma schema for MultiCityExperts.
//
// Models so far:
// - Auth/audit: User, Role, Permission, RolePermission, AuditLog. No auth
//   logic, sessions, or tokens exist yet — this is data modeling only.
// - CMS: Page, PageSection, Service — content models only, no API routes
//   or admin UI. `featuredImageId`/`heroImageId`/`logoId` are plain
//   string references, not foreign keys — there's no media/asset model
//   yet, so they'll become real relations once one is added.
// - Travel master data: Airport, Airline, AirlineContent — reference data.
// - Flight offers: FlightOffer, FlightOfferSegment — data models only, no
//   pricing/search/booking logic.
// - Destinations/routes: DestinationCategory, Destination, Route —
//   reference/content data only, no search or booking logic.
// - Blog: BlogCategory, BlogTag, BlogPost, BlogPostTag — content models
//   only, no API routes or admin UI.
// - Faq, Review, Media — Media is the first real media/asset model;
//   Review.imageId relates to it directly since both are new here. The
//   `featuredImageId`/`heroImageId`/`logoId` placeholders on earlier
//   models are intentionally left as plain strings — wiring them to
//   Media is out of scope for this task, which touches only these three
//   models.
// - SEO: SeoMetadata, Redirect — data models only, no SEO API/middleware
//   yet. SeoMetadata's `ogImageId`/`twitterImageId` are real foreign keys
//   to Media (both fields are new, and Media already exists by this
//   point, unlike the older image-field placeholders above).
// - System: FormSubmission, Navigation, NavigationItem, SiteSettings —
//   data models only. SiteSettings' image fields are real foreign keys to
//   Media for the same reason as SeoMetadata's. (AuditLog already existed
//   from an earlier task and matches this task's spec exactly — nothing
//   to add there.)
//
// - Auth continued: GET /me and POST /logout added `User.tokenVersion` —
//   a counter embedded in each session JWT and bumped on logout, so a
//   logged-out token is rejected server-side even if replayed, not just
//   discarded client-side.
// - Security hardening: `User.failedLoginAttempts`/`lockedUntil` added
//   for silent per-account login lockout (see services/auth.service.ts).
// - Password reset/change: PasswordResetToken added for forgot/reset
//   password. No email service exists yet — see services/auth.service.ts
//   for how the token is currently surfaced instead.
//
// Other domain models will be added in later tasks alongside their own
// services/repositories.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  passwordHash        String
  roleId              String
  isActive            Boolean   @default(true)
  lastLoginAt         DateTime?
  /// Bumped on logout so previously issued session tokens (which embed
  /// the version they were issued under) stop verifying — this is what
  /// makes logout actually invalidate a session server-side, rather than
  /// just relying on the client to discard its cookie.
  tokenVersion        Int       @default(0)
  /// Consecutive failed login attempts since the last success. Reset to
  /// 0 on a successful login. See `lockedUntil`.
  failedLoginAttempts Int       @default(0)
  /// Set once `failedLoginAttempts` crosses the threshold in
  /// `services/auth.service.ts`; while in the future, login is rejected
  /// regardless of whether the submitted password is correct. This is
  /// what defends a single account against brute force even when the
  /// attempts are spread across many IPs (which per-IP rate limiting
  /// alone wouldn't catch).
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  role                Role                 @relation(fields: [roleId], references: [id])
  auditLogs           AuditLog[]
  pagesCreated        Page[]               @relation("PagesCreatedBy")
  pagesUpdated        Page[]               @relation("PagesUpdatedBy")
  blogPosts           BlogPost[]
  passwordResetTokens PasswordResetToken[]

  @@index([roleId])
  @@index([isActive])
  @@map("users")
}

/// A single-use password reset token. `tokenHash` stores a SHA-256 digest
/// of the raw token (`lib/reset-token.ts`) — not bcrypt, since the raw
/// token is already a 256-bit random value with no meaningful entropy to
/// protect against via slow hashing (unlike a user-chosen password). The
/// raw token itself is only ever handed to the requester (currently
/// logged, not emailed — see services/auth.service.ts) and never stored.
/// `usedAt` enforces single-use; `onDelete: Cascade` since a token has no
/// meaning without its user.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Append-only audit trail — rows are written once and never updated
/// (hence no `updatedAt`). `userId` is nullable and set null (not
/// cascade-deleted) if the user is later removed, so the audit record
/// outlives the account it describes. `oldData`/`newData` are nullable
/// since a create has no `oldData` and a delete has no `newData`.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String
  oldData    Json?
  newData    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Shared publish-lifecycle status for CMS content (Page, Service).
enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// A CMS page. `createdBy`/`updatedBy` are nullable with `ON DELETE SET
/// NULL` — deleting the authoring user must not delete or block deletion
/// of their pages, only drop the attribution (same pattern as AuditLog).
model Page {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  pageType        String
  template        String
  status          ContentStatus @default(DRAFT)
  featuredImageId String?
  createdBy       String?
  updatedBy       String?
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  creator  User?         @relation("PagesCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updater  User?         @relation("PagesUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  sections PageSection[]

  @@index([status])
  @@index([pageType])
  @@index([createdBy])
  @@index([updatedBy])
  @@index([publishedAt])
  @@map("pages")
}

/// A content block within a page. `data` holds section-type-specific
/// structured content (shape varies per `sectionType`); `content` is
/// freeform body text/HTML. Deleting a page deletes its sections —
/// a section has no meaning without its parent page.
model PageSection {
  id          String   @id @default(cuid())
  pageId      String
  sectionType String
  title       String?
  subtitle    String?
  content     String?
  data        Json?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, sortOrder])
  @@index([sectionType])
  @@map("page_sections")
}

/// A service offering listed on the site (e.g. a product/service page
/// entry). No author attribution fields — unlike Page, none were
/// requested for this model.
model Service {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  shortDescription String?
  description      String?
  heroImageId      String?
  icon             String?
  status           ContentStatus @default(DRAFT)
  sortOrder        Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status])
  @@index([sortOrder])
  @@map("services")
}

/// Reference data for a physical airport. `iataCode` is required and
/// unique (every airport this platform lists is expected to have one);
/// `icaoCode` is optional but unique when present — Postgres unique
/// constraints permit multiple NULLs, so this doesn't block airports
/// without one.
model Airport {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  iataCode    String   @unique
  icaoCode    String?  @unique
  city        String
  country     String
  countryCode String
  latitude    Float
  longitude   Float
  timezone    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  originSegments      FlightOfferSegment[] @relation("SegmentOriginAirport")
  destinationSegments FlightOfferSegment[] @relation("SegmentDestinationAirport")
  originRoutes        Route[]              @relation("RouteOriginAirport")
  destinationRoutes   Route[]              @relation("RouteDestinationAirport")

  @@index([city])
  @@index([country])
  @@index([countryCode])
  @@index([isActive])
  @@map("airports")
}

/// Reference data for an airline. `logoId` is a plain string, not a
/// foreign key — same reason as `pages.featuredImageId` (no media/asset
/// model yet).
model Airline {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  iataCode    String   @unique
  icaoCode    String?  @unique
  country     String
  countryCode String
  logoId      String?
  websiteUrl  String?
  description String?
  isFeatured  Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  content      AirlineContent?
  flightOffers FlightOffer[]
  segments     FlightOfferSegment[]

  @@index([country])
  @@index([countryCode])
  @@index([isActive])
  @@index([isFeatured])
  @@index([sortOrder])
  @@map("airlines")
}

/// Long-form editorial content for an airline, split out from `Airline`
/// to keep that table lean. Strictly one-to-one — `airlineId` is unique
/// — and cascade-deletes with its airline since it has no meaning on its
/// own.
model AirlineContent {
  id                   String   @id @default(cuid())
  airlineId            String   @unique
  overview             String?
  businessClassContent String?
  firstClassContent    String?
  loungeContent        String?
  routeContent         String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  airline Airline @relation(fields: [airlineId], references: [id], onDelete: Cascade)

  @@map("airline_content")
}

/// Cabin class, shared between FlightOffer (the offer's headline cabin)
/// and FlightOfferSegment (each individual segment's actual cabin —
/// segments can theoretically differ from the offer's headline cabin on
/// mixed-cabin itineraries).
enum CabinClass {
  ECONOMY
  PREMIUM_ECONOMY
  BUSINESS
  FIRST
}

/// A sellable flight offer — one or more `FlightOfferSegment`s make up
/// the itinerary. `price`/`originalPrice` use `Decimal` (not `Float`) to
/// avoid floating-point rounding on money. `airlineId` uses the default
/// `ON DELETE RESTRICT` — an airline with live offers can't be deleted
/// out from under them.
model FlightOffer {
  id            String     @id @default(cuid())
  title         String
  airlineId     String
  cabinClass    CabinClass
  price         Decimal    @db.Decimal(10, 2)
  currency      String
  originalPrice Decimal?   @db.Decimal(10, 2)
  offerLabel    String?
  description   String?
  featured      Boolean    @default(false)
  isActive      Boolean    @default(true)
  validFrom     DateTime?
  validUntil    DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  airline  Airline              @relation(fields: [airlineId], references: [id])
  segments FlightOfferSegment[]

  @@index([airlineId])
  @@index([cabinClass])
  @@index([isActive])
  @@index([featured])
  @@index([validFrom])
  @@index([validUntil])
  @@map("flight_offers")
}

/// One leg of a FlightOffer's itinerary. `flightOfferId` is `ON DELETE
/// CASCADE` (a segment has no meaning without its parent offer, like
/// PageSection/Page). `airlineId`, `originAirportId`, and
/// `destinationAirportId` keep the default `ON DELETE RESTRICT` — you
/// can't delete an airline or airport that existing segments reference.
/// No `createdAt`/`updatedAt` — segments are created/replaced as a batch
/// with their offer, not edited individually over time.
model FlightOfferSegment {
  id                   String     @id @default(cuid())
  flightOfferId        String
  airlineId            String
  flightNumber         String
  originAirportId      String
  destinationAirportId String
  departureAt          DateTime
  arrivalAt            DateTime
  cabinClass           CabinClass
  bookingClass         String
  durationMinutes      Int
  stops                Int        @default(0)
  baggage              String?
  sortOrder            Int        @default(0)

  flightOffer        FlightOffer @relation(fields: [flightOfferId], references: [id], onDelete: Cascade)
  airline            Airline     @relation(fields: [airlineId], references: [id])
  originAirport      Airport     @relation("SegmentOriginAirport", fields: [originAirportId], references: [id])
  destinationAirport Airport     @relation("SegmentDestinationAirport", fields: [destinationAirportId], references: [id])

  @@index([flightOfferId, sortOrder])
  @@index([airlineId])
  @@index([originAirportId])
  @@index([destinationAirportId])
  @@index([departureAt])
  @@map("flight_offer_segments")
}

/// Simple taxonomy for grouping destinations (e.g. "Beach", "City
/// Break", "Adventure").
model DestinationCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  destinations Destination[]

  @@map("destination_categories")
}

/// A destination (city/region) content entry. `categoryId` is nullable
/// with `ON DELETE SET NULL` — deleting a category declassifies its
/// destinations rather than deleting them (same pattern used elsewhere
/// for optional attribution/classification relations). `iataCode` here
/// is a metro/city code (e.g. "NYC", "LON") for display, not a unique
/// key — unlike Airport.iataCode, it isn't required to be unique since
/// it isn't a primary identifier for this model. `heroImageId` is a
/// plain string, not a foreign key, for the same reason as
/// `pages.featuredImageId` (no media/asset model yet).
model Destination {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  city        String
  country     String
  countryCode String
  region      String
  iataCode    String?
  description String?
  heroImageId String?
  categoryId  String?
  isFeatured  Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category DestinationCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([city])
  @@index([country])
  @@index([countryCode])
  @@index([region])
  @@index([categoryId])
  @@index([isFeatured])
  @@index([isActive])
  @@map("destinations")
}

/// A content page for a specific origin→destination airport pair (e.g.
/// a programmatic SEO route page). `originAirportId`/`destinationAirportId`
/// keep the default `ON DELETE RESTRICT` — can't delete an airport still
/// referenced by a route. `description` is a short summary; `content` is
/// the long-form body.
model Route {
  id                   String   @id @default(cuid())
  originAirportId      String
  destinationAirportId String
  slug                 String   @unique
  title                String
  description          String?
  content              String?
  isFeatured           Boolean  @default(false)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  originAirport      Airport @relation("RouteOriginAirport", fields: [originAirportId], references: [id])
  destinationAirport Airport @relation("RouteDestinationAirport", fields: [destinationAirportId], references: [id])

  @@index([originAirportId, destinationAirportId])
  @@index([isFeatured])
  @@index([isActive])
  @@map("routes")
}

/// Simple taxonomy for grouping blog posts (e.g. "Travel Tips", "Guides").
model BlogCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts BlogPost[]

  @@map("blog_categories")
}

/// A freeform label for a blog post, many-to-many via BlogPostTag.
model BlogTag {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  postTags BlogPostTag[]

  @@map("blog_tags")
}

/// A blog post. `status` reuses the `ContentStatus` enum shared with
/// Page/Service. `authorId`/`categoryId` are nullable with `ON DELETE SET
/// NULL` — deleting the author or category drops the attribution/
/// classification, not the post (same pattern as `pages.createdBy` and
/// `destinations.categoryId`). `featuredImageId` is a plain string, not a
/// foreign key, for the same reason as `pages.featuredImageId`.
model BlogPost {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  excerpt         String?
  content         String
  featuredImageId String?
  authorId        String?
  categoryId      String?
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?
  readingTime     Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  author   User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  category BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags     BlogPostTag[]

  @@index([status])
  @@index([categoryId])
  @@index([authorId])
  @@index([publishedAt])
  @@map("blog_posts")
}

/// Join table between BlogPost and BlogTag. Both sides cascade — a tag
/// assignment has no meaning once either the post or the tag is gone
/// (same pattern as RolePermission).
model BlogPostTag {
  blogPostId String
  blogTagId  String

  post BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  tag  BlogTag  @relation(fields: [blogTagId], references: [id], onDelete: Cascade)

  @@id([blogPostId, blogTagId])
  @@index([blogTagId])
  @@map("blog_post_tags")
}

/// The set of content types an FAQ entry can be attached to (polymorphic
/// association via `entityType`/`entityId`, same pattern as
/// AuditLog.entityType — except here the set of valid targets is small
/// and known, so it's an enum rather than a free string). Both fields are
/// nullable so a FAQ can also be "general" (not attached to any entity).
enum FaqEntityType {
  PAGE
  DESTINATION
  SERVICE
  AIRLINE
  FLIGHT_OFFER
  ROUTE
  BLOG_POST
}

/// A question/answer entry, optionally attached to a specific entity
/// (e.g. the FAQs shown on one Destination's page) via the nullable
/// `entityType`/`entityId` pair, or left unattached for a general FAQ
/// list.
model Faq {
  id         String         @id @default(cuid())
  question   String
  answer     String
  entityType FaqEntityType?
  entityId   String?
  sortOrder  Int            @default(0)
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([entityType, entityId, sortOrder])
  @@index([isActive])
  @@map("faqs")
}

/// Moderation lifecycle for a submitted testimonial — distinct from
/// `ContentStatus` (draft/published/archived editorial content) since a
/// review's lifecycle is about moderation, not authoring.
enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A customer testimonial. `rating` is expected to be 1-5 — not enforced
/// at the database level, so validate it in the future service/validation
/// layer. `imageId` is a real foreign key to `Media` (unlike the
/// placeholder image fields on earlier models) since both are introduced
/// together here; `ON DELETE SET NULL` so removing the media asset drops
/// the reviewer's photo, not the review itself.
model Review {
  id        String       @id @default(cuid())
  name      String
  company   String?
  rating    Int
  content   String
  imageId   String?
  status    ReviewStatus @default(PENDING)
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  image Media? @relation(fields: [imageId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([sortOrder])
  @@index([rating])
  @@index([imageId])
  @@map("reviews")
}

/// An uploaded media asset. `url` is unique — each row represents one
/// distinct file, not a duplicate pointer to an existing one.
/// `width`/`height` are nullable since they only apply to image/video
/// assets, not e.g. documents.
model Media {
  id        String   @id @default(cuid())
  filename  String
  url       String   @unique
  altText   String?
  title     String?
  caption   String?
  width     Int?
  height    Int?
  mimeType  String
  size      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews             Review[]
  ogSeoMetadata       SeoMetadata[]  @relation("SeoOgImage")
  twitterSeoMetadata  SeoMetadata[]  @relation("SeoTwitterImage")
  logoSiteSettings    SiteSettings[] @relation("SiteSettingsLogo")
  faviconSiteSettings SiteSettings[] @relation("SiteSettingsFavicon")
  ogImageSiteSettings SiteSettings[] @relation("SiteSettingsOgImage")

  @@index([mimeType])
  @@map("media")
}

/// The set of content types that can carry SEO metadata. A separate enum
/// from FaqEntityType (even though the value sets currently match) so
/// this task doesn't need to touch the Faq model at all.
enum SeoEntityType {
  PAGE
  DESTINATION
  SERVICE
  AIRLINE
  FLIGHT_OFFER
  ROUTE
  BLOG_POST
}

/// SEO metadata for one entity, identified polymorphically by
/// `entityType`/`entityId`. Unlike Faq's polymorphic pair, both fields
/// are required here — SEO metadata only makes sense attached to a
/// specific entity, there's no "general" case. `@@unique([entityType,
/// entityId])` is what guarantees at most one SEO record per entity.
/// `robotsIndex`/`robotsFollow` map to the meta-robots "index"/"follow"
/// directives. `ogImageId`/`twitterImageId` are real foreign keys to
/// Media (nullable, `ON DELETE SET NULL`) since both fields are new here
/// and Media already exists — unlike the older placeholder image fields
/// on Page/Service/etc. `schemaData` is the JSON-LD payload for
/// `schemaType` (e.g. `schemaType: "Article"`).
model SeoMetadata {
  id                 String        @id @default(cuid())
  entityType         SeoEntityType
  entityId           String
  seoTitle           String?
  metaDescription    String?
  canonicalUrl       String?
  robotsIndex        Boolean       @default(true)
  robotsFollow       Boolean       @default(true)
  ogTitle            String?
  ogDescription      String?
  ogImageId          String?
  twitterTitle       String?
  twitterDescription String?
  twitterImageId     String?
  schemaType         String?
  schemaData         Json?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  ogImage      Media? @relation("SeoOgImage", fields: [ogImageId], references: [id], onDelete: SetNull)
  twitterImage Media? @relation("SeoTwitterImage", fields: [twitterImageId], references: [id], onDelete: SetNull)

  @@unique([entityType, entityId])
  @@index([ogImageId])
  @@index([twitterImageId])
  @@map("seo_metadata")
}

/// A URL redirect rule. `sourceUrl` is unique — two rules can't both
/// claim the same incoming path. `statusCode` stores the literal HTTP
/// status (301/302/307/308, default 301) rather than an enum, since the
/// field is meant to hold the exact code an eventual redirect handler
/// would respond with; validate it's a real redirect code in the future
/// validation layer.
model Redirect {
  id             String   @id @default(cuid())
  sourceUrl      String   @unique
  destinationUrl String
  statusCode     Int      @default(301)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isActive])
  @@index([destinationUrl])
  @@map("redirects")
}

/// Processing workflow for an inbound form submission.
enum FormSubmissionStatus {
  PENDING
  PROCESSED
  SPAM
  ARCHIVED
}

/// A submitted form (contact, newsletter, quote request, etc.).
/// `formType` stays a free string, not an enum — new form types are
/// expected to be added over time without a schema migration.
/// `name`/`email`/`phone` are nullable since not every form collects all
/// three; `payload` holds the full submitted data as JSON regardless of
/// which fields the form actually had.
model FormSubmission {
  id        String               @id @default(cuid())
  formType  String
  name      String?
  email     String?
  phone     String?
  payload   Json
  ipAddress String?
  userAgent String?
  status    FormSubmissionStatus @default(PENDING)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([formType])
  @@index([status])
  @@index([createdAt])
  @@index([email])
  @@map("form_submissions")
}

/// A named navigation menu (e.g. "Main Menu", "Footer Links"). `location`
/// is unique — only one menu can be assigned to a given placement slot
/// (e.g. "header", "footer") at a time. Kept as a free string rather than
/// an enum, same reasoning as `pages.pageType`/`pages.template` — the set
/// of layout slots is a content/theme concern, not a fixed developer-only
/// enum.
model Navigation {
  id        String   @id @default(cuid())
  name      String
  location  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items NavigationItem[]

  @@map("navigation")
}

/// One link within a Navigation menu. Self-referential `parentId` enables
/// nested (dropdown/submenu) structures; deleting a parent item cascades
/// to its children, and deleting the whole Navigation cascades to all its
/// items. No `createdAt`/`updatedAt` — items are managed as a batch with
/// their menu, not edited individually over time (same reasoning as
/// FlightOfferSegment).
model NavigationItem {
  id           String  @id @default(cuid())
  navigationId String
  label        String
  url          String
  parentId     String?
  sortOrder    Int     @default(0)
  isActive     Boolean @default(true)

  navigation Navigation       @relation(fields: [navigationId], references: [id], onDelete: Cascade)
  parent     NavigationItem?  @relation("NavigationItemChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children   NavigationItem[] @relation("NavigationItemChildren")

  @@index([navigationId, sortOrder])
  @@index([parentId])
  @@index([isActive])
  @@map("navigation_items")
}

/// Global site configuration. Expected to hold a single row in practice
/// (enforcing that is a service-layer concern, not a schema one).
/// `logoId`/`faviconId`/`defaultOgImageId` are real foreign keys to
/// Media, same reasoning as SeoMetadata's image fields — all three are
/// new here and Media already exists. `socialLinks` is JSON (shape like
/// `{ facebook: "...", instagram: "..." }`).
model SiteSettings {
  id                    String   @id @default(cuid())
  siteName              String
  logoId                String?
  faviconId             String?
  phone                 String?
  email                 String?
  address               String?
  socialLinks           Json?
  defaultSeoTitle       String?
  defaultSeoDescription String?
  defaultOgImageId      String?
  gaId                  String?
  gtmId                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  logo           Media? @relation("SiteSettingsLogo", fields: [logoId], references: [id], onDelete: SetNull)
  favicon        Media? @relation("SiteSettingsFavicon", fields: [faviconId], references: [id], onDelete: SetNull)
  defaultOgImage Media? @relation("SiteSettingsOgImage", fields: [defaultOgImageId], references: [id], onDelete: SetNull)

  @@index([logoId])
  @@index([faviconId])
  @@index([defaultOgImageId])
  @@map("site_settings")
}
