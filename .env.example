# PostgreSQL connection string used by Prisma at runtime (queries, migrations).
# Example: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=

# Direct (non-pooled) connection string, used by Prisma for schema
# introspection/migrations when DATABASE_URL points at a connection pooler
# (e.g. PgBouncer). If you're not using a pooler, set this to the same
# value as DATABASE_URL.
DIRECT_URL=

# Public base URL of the site. Exposed to client code by Next.js because of
# the NEXT_PUBLIC_ prefix — never put secrets in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SITE_URL=

# Secret key used to sign/verify session tokens (lib/session.ts). Generate
# one with: openssl rand -base64 32
# Never commit a real value or reuse this across environments.
SESSION_SECRET=

# SMTP configuration for outgoing email (currently: password reset links).
# If any of these are unset, the app falls back to logging the message
# instead of sending it (see lib/mail.ts) — safe for local dev, but means
# no real email goes out.
# Example (Gmail): host=smtp.gmail.com, port=587, user=you@gmail.com,
# password=<App Password, not your login password>.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Cloudinary credentials for admin-uploaded media (page-section images,
# videos). Find these on your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Minimum level logged by lib/logger.ts (e.g. debug, info, warn, error).
# Defaults to "info" if unset.
LOG_LEVEL=

# --- Docker Compose only (docker-compose.yml) --------------------------
# These configure the bundled Postgres container and the app's exposed
# port — ignored if you're running against an external database instead.
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=multicityexperts
# POSTGRES_PORT=5432
# APP_PORT=3000
